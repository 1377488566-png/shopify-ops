# ============================================================
# .env.example —— 环境变量模板
# 用法：复制成 .env 然后填你自己的值
#   copy .env.example .env
# 注意：.env 里是真实密钥，不要提交到 Git，不要发给别人。
# ============================================================

# ---------- Shopify（不填就自动进入 mock 模式，不会发任何真实请求）----------
# 店铺域名，只写 <你的店铺>.myshopify.com，不要带 https://
SHOPIFY_SHOP=

# Admin API 访问令牌（自己到 Shopify 后台创建自定义 App 后获取）
# 后台路径：Settings -> Apps and sales channels -> Develop apps -> Create an app
#           -> Configure Admin API scopes -> 勾选 read_orders / read_customers
#           -> Install app -> 复制 “Admin API access token”（只显示一次）
SHOPIFY_ACCESS_TOKEN=

# Admin API 版本，一般用当前稳定版即可
SHOPIFY_API_VERSION=2024-07

# Webhook 验签密钥（在后台创建 webhook 时由 Shopify 提供）
SHOPIFY_WEBHOOK_SECRET=


# ---------- DeepSeek（AI 写英文售后邮件；不填就自动用内置英文模板兜底）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ---------- 运行开关 ----------
# 强制 mock：true = 只用内置假数据，绝不向真实店铺发请求
MOCK=true

# SQLite 数据库文件位置（留空用默认 data/shopify.db）
DB_PATH=
